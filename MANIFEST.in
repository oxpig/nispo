include LICENSE
include README.md
include pyproject.toml

recursive-include nispo *.py
recursive-include nispo/resources/opsin_tokens *.xml
include nispo/resources/generated_fused_template_element_graph_index.json
include nispo/resources/generated_fused_template_graph_index.json
include nispo/resources/generated_fused_template_index.json
include nispo/resources/generated_fused_template_index_records.json.gz
include nispo/resources/generated_fused_templates.json
include nispo/resources/generated_spiro_scaffold_templates.json
include nispo/resources/high_impact_fused_parent_templates.json
include nispo/resources/opsin_polyacene_helicene_templates.json
include nispo/resources/opsin_polycyclic_arene_templates.json
include nispo/resources/opsin_retained_mono_fused_ring_smiles.csv
include nispo/resources/opsin_retained_mono_fused_ring_templates.json
include nispo/resources/opsin_test_scaffold_templates.json

prune build
prune dist
prune tests
prune tools
prune graphify-out
prune nispo/graphify-out
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
exclude nispo/resources/generated_fused_template_index_records.json
